# ---------------------------------------------------------------------------
# Runtime configuration.
#
# Every one of these already has a working default baked into the Dockerfile;
# this file documents them and lets you override any of them locally
# (docker run --env-file .env ...). On Hugging Face Spaces, set the ones you
# want to change under Settings -> Variables and secrets.
#
# NOTE: none of these point at a download. Every model is inside the image.
# ---------------------------------------------------------------------------

# --- manga-image-translator -> local Hy-MT2 -------------------------------
# These four names are read verbatim by
# manga_translator/translators/keys.py, do not rename them.
CUSTOM_OPENAI_API_BASE=http://127.0.0.1:8081/v1
# llama.cpp ignores the key, but the openai client requires a non-empty value.
CUSTOM_OPENAI_API_KEY=hy-mt2-local
# Must match --alias passed to llama-server in scripts/entrypoint.sh.
CUSTOM_OPENAI_MODEL=hy-mt2
# Optional sub-key under "ollama:" in config/gpt_config.yaml. Leave empty.
CUSTOM_OPENAI_MODEL_CONF=

# --- llama-server ---------------------------------------------------------
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8081
# Layers to put on the GPU. 99 = all. Forced to 0 automatically when no GPU is
# visible, so it is safe to leave at 99.
LLAMA_N_GPU_LAYERS=99
# Total context shared across slots. 8192/2 slots = 4096 per slot, which is
# what the upstream translator assumes (_MAX_TOKENS).
LLAMA_CTX_SIZE=8192
LLAMA_PARALLEL=2
LLAMA_THREADS=4
# How long to wait for the model to load before giving up (seconds).
LLAMA_STARTUP_TIMEOUT=600

# --- web app --------------------------------------------------------------
APP_PORT=7860
WORK_DIR=/tmp/mnaga-work
MAX_UPLOAD_FILES=300
# Font used to draw the translation. MUST contain Turkish glyphs
# (g-breve, dotless i, dotted I, s-cedilla). Upstream's anime_ace*.ttf do NOT.
RENDER_FONT=comic shanns 2.ttf
GPT_CONFIG_PATH=/app/config/gpt_config.yaml

# --- paths (set by the Dockerfile, change only if you rebuild) -------------
MIT_ROOT=/opt/manga-image-translator
HY_MT2_MODEL_PATH=/opt/models/hy-mt2/Hy-MT2-7B-Q4_K_M.gguf
HF_HOME=/opt/hf-cache

# Keep the HF libraries from trying to reach the network at runtime.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
