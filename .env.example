# ---------------------------------------------------------------------------
# Runtime configuration.
#
# Every one of these already has a working default baked into the Dockerfile;
# this file documents them and lets you override any of them locally
# (docker run --env-file .env ...). On Hugging Face Spaces, set the ones you
# want to change under Settings -> Variables and secrets.
#
# NOTE: none of these point at a download. Every model is inside the image.
# ---------------------------------------------------------------------------

# --- manga-image-translator -> local Hy-MT2 -------------------------------
# These four names are read verbatim by
# manga_translator/translators/keys.py, do not rename them.
CUSTOM_OPENAI_API_BASE=http://127.0.0.1:8081/v1
# llama.cpp ignores the key, but the openai client requires a non-empty value.
CUSTOM_OPENAI_API_KEY=hy-mt2-local
# Must match --alias passed to llama-server in scripts/entrypoint.sh.
CUSTOM_OPENAI_MODEL=hy-mt2
# Optional sub-key under "ollama:" in config/gpt_config.yaml. Leave empty.
CUSTOM_OPENAI_MODEL_CONF=

# --- llama-server ---------------------------------------------------------
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8081
# Layers to put on the GPU. 99 = all. Forced to 0 automatically when no GPU is
# visible, so it is safe to leave at 99.
LLAMA_N_GPU_LAYERS=99
# Total context shared across slots. 8192/2 slots = 4096 per slot, which is
# what the upstream translator assumes (_MAX_TOKENS).
LLAMA_CTX_SIZE=8192
LLAMA_PARALLEL=2
LLAMA_THREADS=4
# How long to wait for the model to load before giving up (seconds).
LLAMA_STARTUP_TIMEOUT=600

# --- web app --------------------------------------------------------------
APP_PORT=7860
WORK_DIR=/tmp/mnaga-work
MAX_UPLOAD_FILES=300
# Which font is pre-selected in the UI. The value is a key derived from the
# file name in assets/fonts/: lower-cased, every run of non-alphanumerics
# turned into "_", extension dropped. So "CC Wild Words.ttf" -> cc_wild_words.
# The UI lists every font found in assets/fonts/ regardless of this setting;
# this only decides which one starts selected. An unknown value falls back to
# a font that exists, so it can never leave the app with no font.
RENDER_FONT_KEY=ccwildwords
GPT_CONFIG_PATH=/app/config/gpt_config.yaml

# --- text detection -------------------------------------------------------
# Starting values for the UI's detector and sensitivity controls; both are
# overridable per job from the web form, so these only set the initial state.
#
# "default" is upstream's DBNet. "paddle" is upstream's Rust PP-OCR-family
# detector - it needs no extra download (rusty-manga-image-translator is
# already a requirement) but has not been verified on a real page here.
DETECTOR=default
# Upstream's own defaults are 0.5 / 0.7. Measured on a real 1280x1816 page,
# those cut a small two-word bubble down to its first word, which then dropped
# out of the pipeline and left the English text un-erased. At 0.4 / 0.6 the box
# covers the whole phrase and the page's region count only moved 57 -> 58, so
# the looser threshold did not flood the page with spurious boxes.
DETECT_TEXT_THRESHOLD=0.4
DETECT_BOX_THRESHOLD=0.6

# --- text erasure (leftover "stains" around cleaned bubbles) ---------------
# How far the erase mask grows past the detected glyphs before inpainting.
# Too small leaves a rim of the original ink behind; too large starts eating
# the bubble outline. Both are upstream's own defaults and are NOT tuned here -
# there is no measurement yet saying another value is better. They are
# overridable per job from the web form, so the range can be compared without
# a rebuild.
ERASE_MASK_DILATION=20
# Final dilation kernel. Forced odd; even sizes grow the mask asymmetrically.
ERASE_KERNEL_SIZE=3

# --- paths (set by the Dockerfile, change only if you rebuild) -------------
# Written by the Dockerfile's cache-busting ADD. The app reads the commit SHA
# back out of it and reports it at /health and in the UI header, so "is this
# Space running my latest push?" is a glance rather than an investigation.
BUILD_INFO_PATH=/tmp/app-commit.json
MIT_ROOT=/opt/manga-image-translator
HY_MT2_MODEL_PATH=/opt/models/hy-mt2/Hy-MT2-7B-Q4_K_M.gguf
HF_HOME=/opt/hf-cache

# Keep the HF libraries from trying to reach the network at runtime.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
